{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "授权外置磁盘…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权外置磁盘…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize External Drive…"
          }
        }
      }
    },
    "需要磁盘授权": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要磁盘授权"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive Access Required"
          }
        }
      }
    },
    "授权访问": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权访问"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Access"
          }
        }
      }
    },
    "请选择外置磁盘的根目录。授权后可缩小扫描范围。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择外置磁盘的根目录。授权后可缩小扫描范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the root of an external drive. You can narrow the scan to a folder after granting access."
          }
        }
      }
    },
    "请选择要扫描的外置磁盘根目录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择要扫描的外置磁盘根目录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the root of the external drive you want to scan."
          }
        }
      }
    },
    "隐私政策": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私政策"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        }
      }
    },
    "有文件留在原盘的恢复文件夹": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有文件留在原盘的恢复文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files remain in a recovery folder on the original drive"
          }
        }
      }
    },
    "关闭提示": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭提示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss Notice"
          }
        }
      }
    },
    "找不到恢复文件夹": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到恢复文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery Folder Not Found"
          }
        }
      }
    },
    "请连接原磁盘，或检查文件夹是否已移动。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接原磁盘，或检查文件夹是否已移动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the original drive or check whether the folder has been moved."
          }
        }
      }
    },
    "找不到恢复文件夹。请连接原磁盘，或检查文件夹是否已移动。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到恢复文件夹。请连接原磁盘，或检查文件夹是否已移动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery folder not found. Connect the original drive or check whether the folder has been moved."
          }
        }
      }
    },
    "停止时尚未处理": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止时尚未处理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unprocessed when stopped"
          }
        }
      }
    },
    "留在原盘恢复文件夹": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留在原盘恢复文件夹"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept in recovery folder on original drive"
          }
        }
      }
    },
    "请重新选择扫描范围": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新选择扫描范围"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Scan Scope Again"
          }
        }
      }
    },
    "磁盘的挂载路径已变化。请在「扫描范围」中重新选择文件夹，或选择扫描整块磁盘。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘的挂载路径已变化。请在「扫描范围」中重新选择文件夹，或选择扫描整块磁盘。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive’s mount path changed. In Scan Scope, choose the folder again or choose Scan Entire Drive."
          }
        }
      }
    },
    "推出": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推出"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject"
          }
        }
      }
    },
    "推出磁盘": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推出磁盘"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject Disk"
          }
        }
      }
    },
    "正在推出磁盘…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在推出磁盘…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecting Disk…"
          }
        }
      }
    },
    "空间使用率": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Space Used" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "空间使用率" } }
      }
    },
    "永久删除…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Permanently…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除…"
          }
        }
      }
    },
    "更多清理选项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More Cleanup Options"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多清理选项"
          }
        }
      }
    },
    "确认永久删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Permanent Deletion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认永久删除"
          }
        }
      }
    },
    "所选文件将从磁盘上永久删除，无法从废纸篓恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected files will be permanently deleted from the disk and cannot be restored from the Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件将从磁盘上永久删除，无法从废纸篓恢复。"
          }
        }
      }
    },
    "当前筛选隐藏了 %lld 个已选文件，它们也会永久删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current filter hides %lld selected files. They will also be permanently deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前筛选隐藏了 %lld 个已选文件，它们也会永久删除。"
          }
        }
      }
    },
    "永久删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Permanently"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除"
          }
        }
      }
    },
    "成功永久删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently Deleted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成功永久删除"
          }
        }
      }
    },
    "已删除文件的总大小": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total Size of Deleted Files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除文件的总大小"
          }
        }
      }
    },
    "扫描已暂停，停止后可清理已选文件": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Scan paused. Stop scanning to clean the selected files." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "扫描已暂停，停止后可清理已选文件" } }
      }
    },
    "文件详情": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "File Details" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "文件详情" } }
      }
    },
    "正在清理…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaning…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在清理…"
          }
        }
      }
    },
    "已处理 %lld / %lld 项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed %lld of %lld items"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已处理 %lld / %lld 项"
          }
        }
      }
    },
    "暂停扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停扫描"
          }
