    "继续扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续扫描"
          }
        }
      }
    },
    "停止扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止扫描"
          }
        }
      }
    },
    "正在暂停…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在暂停…"
          }
        }
      }
    },
    "正在停止…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止…"
          }
        }
      }
    },
    "扫描已暂停": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描已暂停"
          }
        }
      }
    },
    "扫描已停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描已停止"
          }
        }
      }
    },
    "上一页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一页"
          }
        }
      }
    },
    "下一页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一页"
          }
        }
      }
    },
    "第 %lld / %lld 页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page %lld of %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld / %lld 页"
          }
        }
      }
    },
    "全选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全选"
          }
        }
      }
    },
    "取消全选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消全选"
          }
        }
      }
    },
    "全选匹配结果": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select All Matches"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全选匹配结果"
          }
        }
      }
    },
    "取消选择匹配结果": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect All Matches"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消选择匹配结果"
          }
        }
      }
    },
    "自动扫描时优先增量扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer incremental automatic scans"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动扫描时优先增量扫描"
          }
        }
      }
    },
    "增量扫描完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incremental scan complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增量扫描完成"
          }
        }
      }
    },
    "自动扫描完成后清理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean after automatic scans"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动扫描完成后清理"
          }
        }
      }
    },
    "清理前确认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm before cleaning"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理前确认"
          }
        }
      }
    },
    "启动、登录和接盘后的自动扫描完成且无读取问题时，清理默认选中的文件。关闭确认后，清理会直接移入废纸篓。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic cleanup uses your default selections after an error-free scan on launch, login, or drive connection. Turn off confirmation to move files to the Trash immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动、登录和接盘后的自动扫描完成且无读取问题时，清理默认选中的文件。关闭确认后，清理会直接移入废纸篓。"
          }
        }
      }
    },
    "确认自动清理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm automatic cleanup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认自动清理"
          }
        }
      }
    },
    "自动清理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic cleanup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动清理"
          }
        }
      }
    },
    "无法确认此磁盘上的废纸篓位置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trash location on this drive could not be verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认此磁盘上的废纸篓位置。"
          }
        }
      }
    },
    "打开恢复文件夹中的 Restore.txt 可查看恢复方法。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Restore.txt in the recovery folder for instructions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开恢复文件夹中的 Restore.txt 可查看恢复方法。"
          }
        }
      }
    },
    "系统未能移入废纸篓，文件保留在原磁盘的恢复文件夹中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not move the recovery folder to the Trash. The files are still in the recovery folder on the original disk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统未能移入废纸篓，文件保留在原磁盘的恢复文件夹中。"
          }
        }
      }
    },
    "恢复文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复文件夹"
          }
        }
      }
    },
    "在 Finder 中显示恢复文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show recovery folder in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中显示恢复文件夹"
          }
        }
      }
    },
    "始终开启": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终开启"
          }
        }
      }
    },
    "设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
